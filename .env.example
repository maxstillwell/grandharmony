# Store real values only in Vercel Environment Variables, never in Git.
# The connected Neon Marketplace integration currently supplies GH_DATABASE_URL.
# DATABASE_URL is an optional compatible alias for local development.
DATABASE_URL=
GH_DATABASE_URL=
AUTH_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN=
# Dedicated server-to-server enquiry ingestion credential, at least 32 characters.
# Configure the same value in Golfview. It grants submission only, no data reads.
GOLFVIEW_ENQUIRY_TOKEN=
