{
  "name": "grand-harmony",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "test": "node --test --test-isolation=none tests/*.cjs",
    "db:status": "node --env-file-if-exists=.env.local scripts/sales-migration-status.cjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
